load("@bazel_lib//:bzl_library.bzl", doc_extract_bzl_library = "bzl_library")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//cargo:cargo_toolchain.bzl", "cargo_toolchain_alias")

exports_files(
    glob(["*.bzl"]) + ["Cargo.toml"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

cargo_toolchain_alias(
    name = "current_cargo_toolchain",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//visibility:public"],
    deps = [
        "//cargo/private:bzl_lib",
        "//cargo/settings:bzl_lib",
    ],
)

doc_extract_bzl_library(
    name = "doc_extract_tests",
    testonly = True,
    srcs = glob(["*.bzl"]),
    deps = [":bzl_lib"],
)
